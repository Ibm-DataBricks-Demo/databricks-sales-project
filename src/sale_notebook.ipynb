    "from pyspark.sql import functions as F\n",
    "data =[\n",
    "    (1,\"Laptop\",50000),\n",
    "    (2,\"Mobile\",30000),\n",
    "    (3,\"Tablet\",20000),\n",
    "    (4,\"Laptop\",50000)]\n",
    "columns = [\"id\",\"product\",\"amount\"]\n",
    "df=spark.createDataFrame(data,columns)\n",
    "result= df.withColumn(\"Tax\",F.col(\"amount\") * 0.18)\n",
    "display(result)"
   ]
  }
